# --- Base de datos (Supabase) ---
# Usar el POOLER (puerto 6543) con pgbouncer=true: la conexión directa al 5432 se
# agota enseguida con Prisma en un host chico como el free de Render.
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Para `prisma migrate deploy` hace falta la conexión DIRECTA (el pooler no
# soporta las sentencias de migración). Se usa solo en el build.
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Servidor ---
POS_HOST=0.0.0.0
NODE_ENV=production

# Origen del front en Netlify, para CORS en llamadas directas a la API.
POS_ORIGEN_WEB="https://TU-SITIO.netlify.app"

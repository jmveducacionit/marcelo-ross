{
  "name": "marcelo-ross-cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "POS Marcelo Ross — despliegue en la nube (vitrina). Netlify + Render + Supabase.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:server": "pnpm --filter @pos/pos-server dev",
    "dev:web": "pnpm --filter @pos/pos-web dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "build:web": "pnpm --filter @pos/pos-web build",
    "deploy:migrate": "prisma migrate deploy",
    "start:server": "pnpm --filter @pos/pos-server start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@pos/core-domain": "workspace:*",
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "esbuild"
    ]
  }
}

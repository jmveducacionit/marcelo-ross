{
  "name": "marcelo-ross-pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema POS multi-sucursal offline-first para Marcelo Ross Hombre",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "pnpm --filter @pos/pos-web build",
    "build:app": "pnpm build:web && node scripts/build-app.mjs",
    "typecheck": "tsc -b",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:server": "pnpm --filter @pos/pos-server dev",
    "dev:web": "pnpm --filter @pos/pos-web dev",
    "setup": "prisma migrate deploy && prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@pos/core-domain": "workspace:*",
    "@prisma/client": "^6.2.1",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/darwin-arm64"
    ]
  }
}

// ============================================================================
// Esquema CONCEPTUAL del POS — anticipa los 8 módulos.
// Fase 1: andamiaje. Las migraciones se aplican por ETAPAS (ver docs/roadmap.md);
// este archivo describe el modelo completo comentado, no se migra entero de una.
//
// Convenciones (ver CLAUDE.md §4 y docs/modelo-datos.md):
//  - IDs: UUIDv7 generado EN LA APP (no autoincremental). Tipo String @id.
//    No usamos @default(uuid()) para dejar claro que el id lo genera la app
//    (necesario para offline-first sin colisiones). Ver ADR-0008.
//  - Dinero: BigInt = centavos de ARS. NUNCA Float. Ver ADR-0003.
//  - Multi-sucursal: toda entidad con stock/caja/venta lleva sucursalId.
//  - Precios versionados + snapshot en la línea de venta. Ver ADR-0003.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// BASE / MULTI-SUCURSAL
// ===========================================================================

model Sucursal {
  id                String  @id
  nombre            String
  direccion         String?
  esDepositoCentral Boolean @default(false)

  cajas       Caja[]
  puntosVenta PuntoVenta[]
  stock       StockPorSucursal[]
  // ...relaciones inversas se completan al implementar cada etapa.
}

model Caja {
  id         String   @id
  sucursalId String
  nombre     String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
}

// ===========================================================================
// MÓDULO 2 — STOCK  (Etapa 2)  — matriz talle×color con escalas configurables
// ===========================================================================

model Categoria {
  id            String          @id
  nombre        String
  // Cada categoría define qué escala de talle usa (ADR-0002).
  escalaTalleId String?
  escalaTalle   EscalaTalle?    @relation(fields: [escalaTalleId], references: [id])
  productos     ProductoPadre[]
}

model EscalaTalle {
  id         String      @id
  nombre     String // "Camisería 38-44", "Denim 28-36", "Calzado 39-45"...
  talles     Talle[]
  categorias Categoria[]
}

model Talle {
  id            String      @id
  escalaTalleId String
  etiqueta      String // "40", "M", "42", "U" (único)
  orden         Int // ordena escalas numéricas y no numéricas
  escalaTalle   EscalaTalle @relation(fields: [escalaTalleId], references: [id])
  variantes     Variante[]

  @@unique([escalaTalleId, etiqueta])
}

model Color {
  id        String     @id
  nombre    String
  codigoHex String?
  variantes Variante[]
}

model ProductoPadre {
  id          String     @id
  nombre      String
  marcaId     String
  categoriaId String
  temporadaId String?
  descripcion String?
  marca       Marca      @relation(fields: [marcaId], references: [id])
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  temporada   Temporada? @relation(fields: [temporadaId], references: [id])
  variantes   Variante[]
  // El stock NUNCA se lleva acá — siempre a nivel Variante.
}

model Variante {
  id              String  @id
  productoPadreId String
  talleId         String
  colorId         String
  codigoBarras    String  @unique // generado por el comercio al ingresar stock
  codigoProveedor String?
  esConsignacion  Boolean @default(false) // no propio hasta venderse (ADR-0006)

  productoPadre ProductoPadre      @relation(fields: [productoPadreId], references: [id])
  talle         Talle              @relation(fields: [talleId], references: [id])
  color         Color              @relation(fields: [colorId], references: [id])
  stock         StockPorSucursal[]
  precios       PrecioVariante[]
  movimientos   MovimientoStock[]

  @@unique([productoPadreId, talleId, colorId])
}

model StockPorSucursal {
  id         String   @id
  varianteId String
  sucursalId String
  cantidad   Int // proyección del ledger MovimientoStock
  variante   Variante @relation(fields: [varianteId], references: [id])
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([varianteId, sucursalId])
}

model MovimientoStock {
  id           String   @id
  varianteId   String
  sucursalId   String
  tipo         String // INGRESO | VENTA | DEVOLUCION | AJUSTE | TRANSFERENCIA_* | INVENTARIO
  cantidad     Int // +/-
  motivo       String?
  referenciaId String? // remito | venta | transferencia | inventario
  usuarioId    String
  ocurridoEn   DateTime @default(now())
  variante     Variante @relation(fields: [varianteId], references: [id])
}

// Precio de venta VERSIONADO (ADR-0003). Cambiar precio = insertar fila nueva.
model PrecioVariante {
  id           String    @id
  varianteId   String
  precio       BigInt // Money (centavos ARS)
  vigenteDesde DateTime
  vigenteHasta DateTime?
  motivo       String?
  variante     Variante  @relation(fields: [varianteId], references: [id])
}

// Ingresos, transferencias e inventario (modelos base; se detallan en Etapa 2).
model Remito {
  id            String   @id
  proveedorId   String
  sucursalId    String
  ordenCompraId String?
  numero        String // el que trae el papel del proveedor
  fecha         DateTime
  estado        String // PENDIENTE | RECIBIDO
  /// Money — suma de las líneas. Es lo que se le debe al proveedor por este remito.
  total         BigInt   @default(0)

  lineas LineaRemito[]

  @@index([proveedorId, fecha])
}

model LineaRemito {
  id         String @id
  remitoId   String
  varianteId String
  cantidad   Int
  /// Money — costo de compra, NO precio de venta. Snapshot de lo pactado.
  costoUnitario BigInt

  remito Remito @relation(fields: [remitoId], references: [id])
}

model Transferencia {
  id                String    @id
  sucursalOrigenId  String
  sucursalDestinoId String
  estado            String // ENVIADA | RECIBIDA | CON_DIFERENCIA
  fechaEnvio        DateTime
  fechaRecepcion    DateTime?
  // líneas: (varianteId, cantidad)  — envío y recepción separados (offline)
}

model InventarioFisico {
  id         String   @id
  sucursalId String
  fecha      DateTime
  estado     String
  // líneas: (varianteId, cantidadSistema, cantidadContada, diferencia)
}

// ===========================================================================
// MÓDULO 1 — VENTAS  (Etapa 3)
// ===========================================================================

model Venta {
  id              String   @id
  sucursalId      String
  cajaId          String
  vendedorId      String
  clienteId       String?
  fechaHora       DateTime @default(now())
  estadoVenta     String // CONFIRMADA | ANULADA
  estadoEntrega   String // ENTREGADA | PENDIENTE_AJUSTE  (vendido != entregado)
  subtotal        BigInt // Money
  totalDescuentos BigInt // Money
  total           BigInt // Money
  esCambio        Boolean  @default(false)

  lineas  LineaVenta[]
  pagos   Pago[]
  cliente Cliente?     @relation(fields: [clienteId], references: [id])
}

model LineaVenta {
  id             String  @id
  ventaId        String
  varianteId     String
  cantidad       Int
  precioUnitario BigInt // Money — SNAPSHOT al momento de la venta (no FK al vigente)
  subtotalLinea  BigInt // Money
  requiereAjuste Boolean @default(false)
  detalleAjuste  String?
  venta          Venta   @relation(fields: [ventaId], references: [id])

  descuentos DescuentoAplicado[]
}

// Descuentos auditables a nivel línea (ADR-0004).
model Descuento {
  id                   String              @id
  nombre               String // lo que ve el cajero en pantalla
  tipo                 String // PORCENTAJE | MONTO_FIJO | COMBO | LIQUIDACION | EMPLEADO | PROMO_BANCARIA
  reglas               Json
  vigenciaDesde        DateTime?
  vigenciaHasta        DateTime?
  requiereAutorizacion Boolean             @default(false)
  aplicaciones         DescuentoAplicado[]
}

model DescuentoAplicado {
  id              String      @id
  lineaVentaId    String?
  ventaId         String? // descuentos de nivel ticket (se prorratean)
  descuentoId     String
  tipo            String
  montoDescontado BigInt // Money — snapshot del monto, no una fórmula
  autorizadoPor   String?
  lineaVenta      LineaVenta? @relation(fields: [lineaVentaId], references: [id])
  descuento       Descuento   @relation(fields: [descuentoId], references: [id])
}

model Pago {
  id                String  @id
  ventaId           String
  medio             String // EFECTIVO | DEBITO | CREDITO | TRANSFERENCIA | QR | GIFTCARD | CREDITO_CLIENTE
  monto             BigInt // Money
  cuotas            Int?
  interes           BigInt? // Money
  procesador        String? // MODO | MercadoPago | ...
  referenciaExterna String?
  venta             Venta   @relation(fields: [ventaId], references: [id])
}

model Devolucion {
  id            String   @id
  ventaOrigenId String?
  clienteId     String? // necesario para CREDITO_A_FAVOR sin ticket
  sucursalId    String
  cajaId        String
  usuarioId     String
  fecha         DateTime @default(now())
  conTicket     Boolean
  resolucion    String // NOTA_CREDITO | CREDITO_A_FAVOR | CAMBIO
  motivo        String?
  total         BigInt // Money — suma de las líneas devueltas

  lineas LineaDevolucion[]
}

model LineaDevolucion {
  id           String @id
  devolucionId String
  varianteId   String
  cantidad     Int
  /// Money — SNAPSHOT de lo que se le devuelve al cliente por unidad.
  /// Con ticket sale del precio pagado en la venta original (que ya trae su
  /// propio snapshot); sin ticket, del precio vigente. NUNCA una FK al precio.
  precioUnitario BigInt
  /// Línea de la venta original, cuando la devolución tiene ticket.
  lineaVentaOrigenId String?

  devolucion Devolucion @relation(fields: [devolucionId], references: [id])
}

// ===========================================================================
// MÓDULO 3 — CONTROL DE CAJA  (Etapa 4)
// ===========================================================================

model Turno {
  id            String    @id
  sucursalId    String
  fechaApertura DateTime
  fechaCierre   DateTime?
}

model SesionCaja {
  id            String           @id
  cajaId        String
  sucursalId    String // CLAUDE.md §4.3: toda entidad con caja lleva sucursalId
  turnoId       String
  usuarioId     String
  fondoInicial  BigInt // Money
  fechaApertura DateTime         @default(now())
  fechaCierre   DateTime?
  estado        String // ABIERTA | CERRADA
  movimientos   MovimientoCaja[]
  arqueo        Arqueo?

  /// Una caja no puede tener dos sesiones abiertas a la vez. El índice parcial
  /// que lo garantizaría no lo expresa Prisma; se valida en el módulo.
  @@index([cajaId, estado])
}

model MovimientoCaja {
  id           String     @id
  sesionCajaId String
  tipo         String // VENTA | RETIRO | GASTO | INGRESO_MANUAL
  medio        String
  monto        BigInt // Money
  referenciaId String?
  usuarioId    String
  fechaHora    DateTime   @default(now())
  sesion       SesionCaja @relation(fields: [sesionCajaId], references: [id])
}

model Arqueo {
  id           String @id
  sesionCajaId String @unique
  /// Money — efectivo que el cajero contó físicamente.
  totalContado BigInt
  /// Money — efectivo que el sistema esperaba (fondo + ventas − retiros/gastos).
  totalEsperado BigInt
  /// Money con signo: contado − esperado. Negativo = falta plata.
  diferencia    BigInt
  /// Totales esperados por medio de pago, para conciliar lo electrónico.
  /// Se guarda como snapshot: el arqueo tiene que ser reproducible.
  totalesPorMedio Json
  observaciones   String?
  usuarioId       String
  fecha           DateTime @default(now())

  sesion SesionCaja @relation(fields: [sesionCajaId], references: [id])
}

model ConciliacionElectronica {
  id                    String @id
  sucursalId            String
  periodo               String
  medio                 String
  montoSistema          BigInt // Money
  montoLiquidacionBanco BigInt // Money (carga manual en V1)
  diferencia            BigInt // Money
}

// ===========================================================================
// MÓDULO 4 — EMPLEADOS  (Etapa 8; roles mínimos en Etapa 1)
// ===========================================================================

model Usuario {
  id                  String    @id
  nombre              String
  usuario             String    @unique // nombre de usuario para login
  email               String?   @unique
  hashPassword        String // Argon2id (ver auth). NUNCA texto plano.
  rol                 String // ADMIN | ENCARGADO | CAJERO | VENDEDOR | CONTADOR_RO
  sucursalIdPrincipal String
  activo              Boolean   @default(true)
  // Seguridad: control de intentos fallidos y bloqueo temporal (anti fuerza bruta).
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?
  ultimoLogin         DateTime?
  sesiones            Sesion[]
}

// Sesión server-side (revocable). El cliente guarda un token opaco en cookie
// httpOnly; acá se guarda solo su HASH (si se filtra la DB, el token no sirve).
model Sesion {
  id         String    @id
  tokenHash  String    @unique
  usuarioId  String
  sucursalId String?
  creadaEn   DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?
  ip         String?
  userAgent  String?
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model Comision {
  id         String  @id
  vendedorId String
  ventaId    String?
  periodo    String
  base       BigInt // Money — venta NETA de devoluciones
  porcentaje Float
  monto      BigInt // Money
  estado     String // PENDIENTE | LIQUIDADA
}

// ===========================================================================
// MÓDULO 5 — CLIENTES  (Etapa 6)
// ===========================================================================

model Cliente {
  id               String          @id
  nombre           String
  documento        String?
  condicionIva     String
  cuit             String?
  razonSocial      String?
  domicilioFiscal  String?
  email            String?
  telefono         String?
  tallesHabituales TalleHabitual[]
  credito          CreditoCliente?
  ventas           Venta[]
}

model TalleHabitual {
  id          String  @id
  clienteId   String
  categoriaId String
  talleId     String
  cliente     Cliente @relation(fields: [clienteId], references: [id])
}

model CreditoCliente {
  id        String  @id
  clienteId String  @unique
  saldo     BigInt // Money
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  movimientos MovimientoCredito[]
}

/// Ledger del crédito a favor. El saldo es el acumulado; acá está el porqué.
/// Un saldo sin movimientos no se puede auditar ni explicar al cliente.
model MovimientoCredito {
  id               String   @id
  creditoClienteId String
  /// Money con signo: + por devolución, − al usarlo en una venta.
  monto            BigInt
  motivo           String // DEVOLUCION | USO_EN_VENTA | AJUSTE
  devolucionId     String?
  ventaId          String?
  usuarioId        String
  ocurridoEn       DateTime @default(now())

  credito CreditoCliente @relation(fields: [creditoClienteId], references: [id])

  @@index([creditoClienteId, ocurridoEn])
}

// ===========================================================================
// MÓDULO 7 — FACTURACIÓN  (Etapa 5)
// ===========================================================================

model PuntoVenta {
  id           String        @id
  sucursalId   String
  numeroArca   Int
  sucursal     Sucursal      @relation(fields: [sucursalId], references: [id])
  comprobantes Comprobante[]

  @@unique([sucursalId, numeroArca])
}

model Comprobante {
  id             String     @id
  tipo           String // FACTURA_A | FACTURA_B | NOTA_CREDITO | NOTA_DEBITO
  puntoVentaId   String
  numero         Int
  ventaId        String?
  clienteId      String?
  fechaEmision   DateTime   @default(now())
  neto           BigInt // Money
  iva            BigInt // Money
  total          BigInt // Money
  estadoCae      String // PENDIENTE | OBTENIDO | RECHAZADO
  cae            String?
  vencimientoCae DateTime?
  intentos       Int        @default(0)
  puntoVenta     PuntoVenta @relation(fields: [puntoVentaId], references: [id])
  cola           ColaCae?

  @@unique([puntoVentaId, tipo, numero])
}

// Cola de reintentos del CAE (offline-first, ADR-0005).
model ColaCae {
  id             String      @id
  comprobanteId  String      @unique
  estado         String
  ultimoIntento  DateTime?
  proximoIntento DateTime?
  error          String?
  comprobante    Comprobante @relation(fields: [comprobanteId], references: [id])
}

// ===========================================================================
// MÓDULO 8 — PROVEEDORES  (Etapa 7)
// ===========================================================================

model Proveedor {
  id              String                    @id
  razonSocial     String
  cuit            String
  condicionIva    String
  esConsignatario Boolean                   @default(false)
  marcas          Marca[]
  cuentaCorriente CuentaCorrienteProveedor?
}

model Marca {
  id             String          @id
  nombre         String
  proveedorId    String?
  markupObjetivo Float? // 0.55 a 1.30 (55%–130%)
  proveedor      Proveedor?      @relation(fields: [proveedorId], references: [id])
  productos      ProductoPadre[]
}

model Temporada {
  id        String          @id
  nombre    String // "Primavera-Verano" | "Otoño-Invierno"
  anio      Int
  productos ProductoPadre[]
}

model OrdenCompra {
  id          String   @id
  proveedorId String
  temporadaId String?
  numero      String
  fecha       DateTime
  estado      String // ABIERTA | RECIBIDA_PARCIAL | CERRADA | ANULADA
  /// Money — suma de las líneas pedidas.
  total       BigInt   @default(0)

  lineas LineaOrdenCompra[]

  @@index([proveedorId, fecha])
}

model LineaOrdenCompra {
  id            String  @id
  ordenCompraId String
  /// Puede pedirse algo que todavía no existe como variante (temporada nueva).
  varianteId    String?
  descripcion   String
  cantidad      Int
  /// Money — costo unitario pactado.
  costoUnitario BigInt
  /// Cuánto de esta línea ya llegó por remito.
  recibido      Int     @default(0)

  orden OrdenCompra @relation(fields: [ordenCompraId], references: [id])
}

model CuentaCorrienteProveedor {
  id          String    @id
  proveedorId String    @unique
  /// Money — positivo = se le debe al proveedor.
  saldo       BigInt
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  movimientos MovimientoCuentaProveedor[]
}

/// Ledger de la cuenta corriente. Mismo criterio que MovimientoCredito: un saldo
/// sin movimientos no se puede auditar ni discutir con el proveedor.
model MovimientoCuentaProveedor {
  id        String   @id
  cuentaId  String
  /// Money con signo: + lo que se le debe, − los pagos y las devoluciones.
  monto     BigInt
  motivo    String // RECEPCION_REMITO | LIQUIDACION_CONSIGNACION | PAGO | AJUSTE
  remitoId       String?
  liquidacionId  String?
  usuarioId String
  ocurridoEn DateTime @default(now())

  cuenta CuentaCorrienteProveedor @relation(fields: [cuentaId], references: [id])

  @@index([cuentaId, ocurridoEn])
}

model LiquidacionConsignacion {
  id          String   @id
  proveedorId String
  periodo     String // "2026-08"
  desde       DateTime
  hasta       DateTime
  /// Money — total a liquidarle al proveedor por lo vendido de su consignación.
  total       BigInt
  estado      String   @default("EMITIDA") // EMITIDA | PAGADA
  fecha       DateTime @default(now())
  usuarioId   String

  lineas LineaLiquidacion[]

  @@unique([proveedorId, periodo])
}

model LineaLiquidacion {
  id             String @id
  liquidacionId  String
  varianteId     String
  cantidadVendida Int
  /// Money — lo que se le paga al proveedor por unidad (el costo pactado).
  costoUnitario  BigInt
  /// Money — cantidadVendida × costoUnitario.
  montoALiquidar BigInt

  liquidacion LiquidacionConsignacion @relation(fields: [liquidacionId], references: [id])
}

// ===========================================================================
// TRANSVERSAL — AUDITORÍA + OUTBOX (ADR-0008 / ADR-0001)
// ===========================================================================

// Append-only: toda operación con impacto en dinero o stock.
model RegistroAuditoria {
  id         String   @id
  entidad    String
  entidadId  String
  accion     String
  antes      Json?
  despues    Json?
  usuarioId  String
  cajaId     String?
  sucursalId String
  ocurridoEn DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([sucursalId, ocurridoEn])
}

// Outbox transaccional: alimenta el bus de eventos y la sincronización.
// id = eventId (UUIDv7) -> sirve para dedupe idempotente.
model Outbox {
  id         String   @id
  tipoEvento String
  payload    Json
  sucursalId String
  estado     String // PENDIENTE | PUBLICADO | SINCRONIZADO
  ocurridoEn DateTime @default(now())

  @@index([estado, ocurridoEn])
}
